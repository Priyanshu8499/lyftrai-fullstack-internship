# LLM Configuration
# Comma-separated Gemini API keys. At least two provider API keys are required.
LLM_API_KEYS=your_gemini_key_1,your_gemini_key_2
LLM_MODEL=gemini/gemini-2.0-flash
GROQ_API_KEY=
GROQ_MODEL=groq/openai/gpt-oss-20b

# Database
DATABASE_URL=sqlite:////data/app.db

# CORS - comma-separated allowed origins
ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend-url.vercel.app

# Set to true to enable X-Simulate-Failure header for testing failover
ENABLE_FAILURE_SIMULATION=true

# Optional default system prompt
DEFAULT_SYSTEM_PROMPT=You are a helpful assistant.

# Frontend API URL (used at build time for Vite)
VITE_API_URL=http://localhost:8000
